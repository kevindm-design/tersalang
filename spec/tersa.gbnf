upper ::= [A-Z] [A-Za-z0-9]{0,63}
int ::= "0x" [0-9a-fA-F] [0-9a-fA-F_]* | "0b" [0-1] [0-1_]* | [0-9] [0-9_]*
float ::= ( [0-9] [0-9_]* ) "." ( [0-9] [0-9_]* ) ( "e" ( "+" | "-" )? [0-9] [0-9]* )? | ( [0-9] [0-9_]* ) ( "e" ( "+" | "-" )? [0-9] [0-9]* )
text ::= "\"" ( "\\" ( "\"" | "\\" | "n" | "t" | "r" | "{" | "}" | "u" "{" [0-9a-fA-F] [0-9a-fA-F]? [0-9a-fA-F]? [0-9a-fA-F]? [0-9a-fA-F]? [0-9a-fA-F]? "}" ) | [^\"\\\n\r] )* "\""
file-open-n ::= module-decl ( import-decl | top-decl )* ( ( import-decl-open-e | top-decl-open-e )? | import-decl-open-t | top-decl-open-t ) | module-decl-open
import-decl-open-e ::= sgap "import" module-path-w ( sgap1 "as" sgap1 lower )? ( sgap1 "exposing" name-w ( sgap "," name-c )* )? nl
import-decl-open-t ::= sgap "import" module-path-w ( sgap1 "as" sgap1 lower )? ( sgap1 "exposing" name-w ( sgap "," name-c )* )?
top-decl-open-e ::= function-decl-open-e | record-decl-open-e | choice-decl-open-e | interface-decl-open-e | const-decl-open-e | foreign-decl-open-e | sgap "public" ( function-decl-open-we | record-decl-open-we | choice-decl-open-we | interface-decl-open-we | const-decl-open-we | foreign-decl-open-we ) | implements-decl-open-e | test-decl-open-e
top-decl-open-t ::= function-decl-open-t | record-decl-open-t | choice-decl-open-t | interface-decl-open-t | const-decl-open-t | foreign-decl-open-t | sgap "public" ( function-decl-open-wt | record-decl-open-wt | choice-decl-open-wt | interface-decl-open-wt | const-decl-open-wt | foreign-decl-open-wt ) | implements-decl-open-t | test-decl-open-t
function-decl-open-e ::= header sgap "do" nl block-some-n? sgap "end" nl
function-decl-open-t ::= header sgap "do" nl block-some-n? sgap "end"
function-decl-open-we ::= header-w sgap "do" nl block-some-n? sgap "end" nl
function-decl-open-wt ::= header-w sgap "do" nl block-some-n? sgap "end"
record-decl-open-e ::= sgap "record" sgap1 upper type-params? nl record-field* invariant* sgap "end" nl
record-decl-open-t ::= sgap "record" sgap1 upper type-params? nl record-field* invariant* sgap "end"
record-decl-open-we ::= sgap1 "record" sgap1 upper type-params? nl record-field* invariant* sgap "end" nl
record-decl-open-wt ::= sgap1 "record" sgap1 upper type-params? nl record-field* invariant* sgap "end"
choice-decl-open-e ::= sgap "choice" sgap1 upper type-params? nl choice-case* sgap "end" nl
choice-decl-open-t ::= sgap "choice" sgap1 upper type-params? nl choice-case* sgap "end"
choice-decl-open-we ::= sgap1 "choice" sgap1 upper type-params? nl choice-case* sgap "end" nl
choice-decl-open-wt ::= sgap1 "choice" sgap1 upper type-params? nl choice-case* sgap "end"
interface-decl-open-e ::= sgap "interface" sgap1 upper type-params? nl header* sgap "end" nl
interface-decl-open-t ::= sgap "interface" sgap1 upper type-params? nl header* sgap "end"
interface-decl-open-we ::= sgap1 "interface" sgap1 upper type-params? nl header* sgap "end" nl
interface-decl-open-wt ::= sgap1 "interface" sgap1 upper type-params? nl header* sgap "end"
const-decl-open-e ::= sgap "let" sgap1 lower sgap ":" type-c sgap "=" expression-c nl
const-decl-open-t ::= sgap "let" sgap1 lower sgap ":" type-c sgap "=" expression-c
const-decl-open-we ::= sgap1 "let" sgap1 lower sgap ":" type-c sgap "=" expression-c nl
const-decl-open-wt ::= sgap1 "let" sgap1 lower sgap ":" type-c sgap "=" expression-c
foreign-decl-open-e ::= sgap "foreign" sgap text header-open-e
foreign-decl-open-t ::= sgap "foreign" sgap text header-open-t
foreign-decl-open-we ::= sgap1 "foreign" sgap text header-open-e
foreign-decl-open-wt ::= sgap1 "foreign" sgap text header-open-t
header-open-e ::= sgap "function" sgap1 lower type-params? sgap "(" params-b? gap ")" sgap "returns" type-w nl uses? contract* contract-open-e | sgap "function" sgap1 lower type-params? sgap "(" params-b? gap ")" sgap "returns" type-w nl uses-open-e? | sgap "function" sgap1 lower type-params? sgap "(" params-b? gap ")" sgap "returns" type-w nl
header-open-t ::= sgap "function" sgap1 lower type-params? sgap "(" params-b? gap ")" sgap "returns" type-w nl uses? contract* contract-open-t | sgap "function" sgap1 lower type-params? sgap "(" params-b? gap ")" sgap "returns" type-w nl uses-open-t | sgap "function" sgap1 lower type-params? sgap "(" params-b? gap ")" sgap "returns" type-w
contract-open-e ::= ( sgap "requires" | sgap "ensures" ) expression-wc nl
contract-open-t ::= ( sgap "requires" | sgap "ensures" ) expression-wc
uses-open-e ::= sgap "uses" gap1 upper ( sgap "," gap upper )* nl
uses-open-t ::= sgap "uses" gap1 upper ( sgap "," gap upper )*
implements-decl-open-e ::= sgap "implements" sgap1 upper type-args nl function-decl* sgap "end" nl
implements-decl-open-t ::= sgap "implements" sgap1 upper type-args nl function-decl* sgap "end"
test-decl-open-e ::= sgap "test" sgap text ( sgap "for" sgap1 "all" params-w )? nl sgap "do" nl block-some-n? sgap "end" nl
test-decl-open-t ::= sgap "test" sgap text ( sgap "for" sgap1 "all" params-w )? nl sgap "do" nl block-some-n? sgap "end"
module-decl-open ::= sgap "module" module-path-w nl?
