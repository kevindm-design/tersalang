# spec: reference 5.11 type arguments are inferred at call sites
# allow: Console
# expect: stdout
# |Some(1)
# |"s"
# |[3, 3]
# |Set.from_list([2, 1])
module generic_inference

import std.console exposing print

function first[T](xs: List[T]) returns Option[T]
do
  return xs.get(0)
end

function twice[T](x: T) returns List[T]
do
  return [x, x]
end

function id[T](x: T) returns T
do
  return x
end

function main() returns Unit
  uses Console
do
  print(show(first([1, 2])))
  print(show(id("s")))
  print(show(twice(3)))
  print(show(Set.from_list([2, 1, 2])))
  return
end
