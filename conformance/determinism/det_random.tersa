# spec: design 12.6 seeded Random
# expect: stdout
# allow: Console
# allow: Random
# |5
# |0
module det_random

import std.console exposing print
import std.random

function main() returns Unit
  uses Console, Random
do
  print(show(random.int(0, 10)))
  print(show(random.int(0, 10)))
  return
end
