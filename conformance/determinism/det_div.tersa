# spec: design 9.1 floored division is platform-independent
# expect: stdout
# allow: Console
# |-3
# |2
# |0.5
module det_div

import std.console exposing print

function main() returns Unit
  uses Console
do
  print(show((-7) div 3))
  print(show((-7) mod 3))
  print(show(1.0 / 2.0))
  return
end
