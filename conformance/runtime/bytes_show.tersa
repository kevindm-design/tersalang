# spec: language reference 5.6
# allow: Console
# expect: stdout
# |Bytes.of_hex("0aff")
# |Bytes.of_hex("0aff")
# |None
# |None
module bytes_show

import std.console exposing print

function main() returns Unit
  uses Console
do
  print(show(Bytes.of_hex("0aff")))
  print(show(Bytes.of_list([10, 255])))
  match Bytes.from_hex("abc")
    case Some(value) then
      print(show(value))
    case None then
      print("None")
  end
  match Bytes.from_list([10, 300])
    case Some(value) then
      print(show(value))
    case None then
      print("None")
  end
  return
end
