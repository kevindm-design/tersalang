# spec: reference 5.1 Unit has one value, written Unit
# allow: Console
# expect: stdout
# |Ok(Unit)
module unit_value

import std.console exposing print

function done() returns Result[Unit, Text]
do
  let u: Unit = Unit
  return Ok(u)
end

function main() returns Unit
  uses Console
do
  print(show(done()))
  return
end
