# spec: design 9.8 show of a choice
# allow: Console
# expect: stdout
# |Red
# |Rgb(1, 2, 3)
module show_choice

import std.console exposing print

choice Color
  case Red
  case Rgb(r: Int, g: Int, b: Int)
end

function main() returns Unit
  uses Console
do
  print(show(Red))
  print(show(Rgb(1, 2, 3)))
  return
end
